#!/bin/sh
# Guard protected branches against force-push and deletion.
# Installed 2026-10-21. Delete this file to disable.
PROTECTED="main"
ZERO=0000000000000000000000000000000000000000
while read local_ref local_sha remote_ref remote_sha; do
  branch=${remote_ref#refs/heads/}
  case " $PROTECTED " in *" $branch "*) ;; *) continue ;; esac
  if [ "$local_sha" = "$ZERO" ]; then
    echo "pre-push: BLOCKED deletion of protected branch '$branch'." >&2
    exit 1
  fi
  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha" 2>/dev/null; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      echo "pre-push: BLOCKED non-fast-forward (force) push to '$branch'." >&2
      echo "          remote $remote_sha is not an ancestor of $local_sha" >&2
      echo "          If this is intended, bypass with: git push --no-verify" >&2
      exit 1
    fi
  fi
done
exit 0
